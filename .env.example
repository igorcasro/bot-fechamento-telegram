# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
# Dica: depois de iniciado, o bot relê ALLOWED_USER_IDS e MANAGER_CHAT_ID quando você salva
# este arquivo (não precisa reiniciar). Para as outras variáveis, reinicie o bot.

# Token do bot, criado conversando com o @BotFather no Telegram (/newbot)
BOT_TOKEN=

# IDs de quem pode usar o bot, separados por vírgula. OBRIGATÓRIO: vazio = ninguém usa.
# Cada pessoa descobre o próprio ID enviando /start ao bot em conversa privada
# ("Seu ID de usuário") e envia esse número a quem cuida do .env.
# Ex.: ALLOWED_USER_IDS=111111111,222222222,333333333
ALLOWED_USER_IDS=

# ID do grupo que recebe o resumo + PDF. Para descobrir: crie o grupo, adicione o bot e envie
# /start ali; ele responde "ID deste chat: -100...". IDs de grupo são negativos.
# Para trocar de grupo (ou mandar para uma pessoa só), troque o número aqui.
MANAGER_CHAT_ID=

# (opcional) loja = pasta dentro de lojas/ (padrão: divino-fogao)
# LOJA=divino-fogao
# LOJAS_DIR=lojas

# (opcional) onde guardar fotos/PDFs e por quantos dias (padrão: arquivo/ e 7 dias)
# ARCHIVE_DIR=arquivo
# RETENCAO_DIAS=7
