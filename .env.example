# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Token do bot, criado conversando com o @BotFather no Telegram (/newbot)
BOT_TOKEN=

# ID do chat/grupo que recebe o relatório (gerente). Para descobrir:
# adicione o bot ao grupo e envie /start - ou use o @userinfobot.
# IDs de grupo são negativos, ex.: -1001234567890
MANAGER_CHAT_ID=

# (opcional) IDs dos funcionários autorizados, separados por vírgula.
# Vazio = qualquer pessoa que achar o bot consegue usar.
ALLOWED_USER_IDS=

# (opcional) outro arquivo de checklist e pasta de arquivo das fotos
# CHECKLIST_FILE=checklist.yaml
# ARCHIVE_DIR=arquivo
