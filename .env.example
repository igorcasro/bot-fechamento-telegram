# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# Token do bot, criado conversando com o @BotFather no Telegram (/newbot)
BOT_TOKEN=

# ID do grupo que recebe o resumo + PDF (gerência). Para descobrir: adicione o bot ao grupo
# e envie /start (ele mostra o ID de quem escreveu) ou use o @userinfobot / @RawDataBot.
# IDs de grupo são negativos, ex.: -1001234567890.
# Para trocar para uma pessoa depois, basta colocar o ID dela aqui.
MANAGER_CHAT_ID=

# (opcional) IDs dos funcionários autorizados, separados por vírgula.
# Vazio = qualquer pessoa que achar o bot consegue usar. Recomendado preencher em produção.
ALLOWED_USER_IDS=

# (opcional) loja = pasta dentro de lojas/ (padrão: divino-fogao)
# LOJA=divino-fogao
# LOJAS_DIR=lojas

# (opcional) onde guardar fotos/PDFs e por quantos dias (padrão: arquivo/ e 7 dias)
# ARCHIVE_DIR=arquivo
# RETENCAO_DIAS=7
